<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Convite | 15 Anos da Manu</title>

<style>
  *{ margin:0; padding:0; box-sizing:border-box; }

  html,body{
    background:#000;
    width:100%;
    overflow-x:hidden;
  }

  /* ---------- INTRO EM VÍDEO ---------- */
  #intro{
    position:fixed;
    inset:0;
    background:#000;
    z-index:100;
    transition:opacity 1.1s ease;
  }
  #intro.oculto{
    opacity:0;
    pointer-events:none;
  }
  #video-convite{
    width:100%;
    height:100dvh;
    object-fit:cover;
    display:block;
  }
  #pular-video{
    position:absolute;
    bottom:max(20px, env(safe-area-inset-bottom));
    right:20px;
    color:rgba(255,255,255,.75);
    font-family:Georgia, serif;
    font-style:italic;
    font-size:.95rem;
    background:rgba(0,0,0,.3);
    border:1px solid rgba(255,255,255,.4);
    border-radius:30px;
    padding:8px 16px;
    cursor:pointer;
  }
  #ativar-som{
    position:absolute;
    top:max(18px, env(safe-area-inset-top));
    right:18px;
    color:#fff;
    background:rgba(0,0,0,.35);
    border:1px solid rgba(255,255,255,.5);
    border-radius:50%;
    width:44px;
    height:44px;
    font-size:1.2rem;
    cursor:pointer;
    display:none;
    align-items:center;
    justify-content:center;
  }
  #ativar-som.visivel{ display:flex; }

  /* ---------- IMAGEM FINAL ---------- */
  #convite{
    opacity:0;
    transition:opacity 1.2s ease;
  }
  #convite.visivel{ opacity:1; }

  #convite img{
    display:block;
    width:100%;
    height:auto;
  }
</style>
</head>
<body>

  <!-- ===== INTRO: VÍDEO EM TELA CHEIA, COM SOM ===== -->
  <div id="intro">
    <video id="video-convite" playsinline autoplay>
      <source src="video.mp4" type="video/mp4">
    </video>
    <button id="ativar-som" title="Ativar som">🔇</button>
    <button id="pular-video">pular vídeo ›</button>
  </div>

  <!-- ===== IMAGEM DO CONVITE ===== -->
  <main id="convite">
    <img src="arteSite.jpg" alt="Convite 15 anos">
  </main>

<script>
  const intro    = document.getElementById('intro');
  const video    = document.getElementById('video-convite');
  const convite  = document.getElementById('convite');
  const btnPular = document.getElementById('pular-video');
  const btnSom   = document.getElementById('ativar-som');

  function mostrarConvite(){
    intro.classList.add('oculto');
    convite.classList.add('visivel');
    setTimeout(() => intro.remove(), 1200);
  }

  // Tenta tocar com som ligado. Só se o navegador bloquear
  // (alguns exigem interação antes de permitir som), toca mudo
  // e mostra o botão para o convidado ativar manualmente.
  video.play().catch(() => {
    video.muted = true;
    btnSom.classList.add('visivel');
    video.play();
  });

  btnSom.addEventListener('click', () => {
    video.muted = false;
    btnSom.classList.remove('visivel');
  });

  video.addEventListener('ended', mostrarConvite);
  btnPular.addEventListener('click', mostrarConvite);
  video.addEventListener('error', mostrarConvite);
</script>

</body>
</html>
